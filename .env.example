OLLAMA_BASE_URL=https://ollama.com
DB_PATH=./data/ollama_proxy.db
PROBE_MODEL=minimax-m3
TIMEOUT=30
MAX_ROTATION_ITERATIONS_SAFETY_MARGIN=1
MODEL_CACHE_TTL_SECONDS=300
USAGE_REFRESH_INTERVAL_SECONDS=300
USAGE_REQUEST_TIMEOUT_SECONDS=15
ADMIN_TOKEN=
CORS_ALLOW_ORIGINS=
ENABLE_DOCS=
ENABLE_DASHBOARD=
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=
DASHBOARD_SESSION_TTL_SECONDS=3600
DASHBOARD_COOKIE_SECURE=1
DASHBOARD_TEMPLATES_DIR=./templates
CADDY_DOMAIN=
CADDY_EMAIL=